{
  "name": "pi-bar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Git-aware pi footer, background task reminders, clickable local file paths, and a shortcut to edit the last prompt",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./src/footer.ts",
      "./src/notify.ts",
      "./src/file-links.ts",
      "./src/edit-last.ts"
    ]
  },
  "files": [
    "src",
    "assets",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "3.6.2",
    "typescript": "^5.9.3"
  }
}
